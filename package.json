{
  "name": "webgpu-linetowerwars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "balance": "vite-node scripts/balance.ts",
    "server": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "e2e:mp": "lobbyhop e2e --url http://localhost:8787/ -n 3 --seconds 70 --script scripts/e2e-actions.mjs",
    "determinism": "lobbyhop determinism src/multiplayer/determinism.ts",
    "bot": "lobbyhop bot scripts/bot-brain.ts"
  },
  "dependencies": {
    "lobbyhop": "^0.2.0",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.145.0"
  }
}
